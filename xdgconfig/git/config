[ghq]
 root = ~/ghq/

[init]
defaultBranch = main

[core]
pager = delta

[interactive]
diffFilter = delta --color-only

[delta]
navigate = true
light = false
side-by-side = true
line-numbers = true

[merge]
conflictStyle = diff3

[diff]
colorMoved = default

